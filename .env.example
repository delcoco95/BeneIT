# ──────────────────────────────────────────────
# BeneIT Audit — Configuration
# Copiez ce fichier en .env et renseignez vos valeurs
# ──────────────────────────────────────────────

# Serveur
PORT=3000
FRONTEND_URL=http://localhost:3000

# Stripe (paiement du rapport détaillé)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Admin (accès au tableau de bord admin)
ADMIN_TOKEN=changez-moi-en-production

# IA — Groq (commentaire personnalisé, optionnel)
AI_PROVIDER=groq
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=8000
AI_DAILY_BUDGET=300

# SMTP (envoi d'email — requis pour les alertes Sentinelle)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@beneit.fr

# Sentinelle — surveillance uptime + SSL par abonnement
SENTINELLE_STRIPE_PRICE_ID=
SSL_ALERT_DAYS=14

# Cron Sentinelle (déclenché par .github/workflows/sentinelle-cron.yml)
CRON_SECRET=changez-moi-en-production
CRON_STALE_MINUTES=45
ADMIN_ALERT_EMAIL=
